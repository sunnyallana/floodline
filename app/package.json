{
  "name": "floodline-field",
  "private": true,
  "version": "0.1.0",
  "description": "Offline-first capture app for Floodline field reports",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "exifr": "7.1.3",
    "idb": "8.0.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@types/node": "25.9.9",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3"
  }
}
